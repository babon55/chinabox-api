# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ── Database (Railway provides this automatically) ─────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT (generate strong random strings) ──────────────────────
JWT_ACCESS_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_different_random_64_char_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS (your Vercel frontend URL) ───────────────────────────
CORS_ORIGINS=https://your-app.vercel.app

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-api.railway.app/auth/google/callback

# ── Redis (optional - Railway Redis addon) ────────────────────
# REDIS_URL=redis://default:password@host:6379
