{
  "compilerOptions": {
    "skipLibCheck": true,
    "noImplicitAny": false,
    "target":            "ES2022",
    "module":            "NodeNext",
    "moduleResolution":  "NodeNext",
    "outDir":            "./dist",
    "rootDir":           "./src",
    "strict":            true,
    "esModuleInterop":   true,
    "resolveJsonModule": true,
    "sourceMap":         true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}